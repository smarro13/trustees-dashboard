NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Squarespace API key with "Orders" (Transactions) read access, from
# Squarespace Settings > Advanced > API Keys. Used by /agenda/prematch-meals
# to pull live sales figures. Server-side only — never expose with NEXT_PUBLIC_.
SQUARESPACE_API_KEY=your_squarespace_api_key

# Resend (https://resend.com) — emails Presidents Lotto winners when a draw is
# saved. LOTTO_EMAIL_FROM must be on a domain verified in Resend. Leave unset
# to save draws without emailing anyone. Server-side only.
RESEND_API_KEY=your_resend_api_key
LOTTO_EMAIL_FROM=Aldwinians RUFC <lotto@aldwinians.co.uk>
LOTTO_EMAIL_REPLY_TO=info@aldwinians.co.uk

# Club Automation API — plays YouTube links on the clubhouse Firesticks from
# /operations/media-screens. The URL is the API's base address (no /api/v1)
# and must be reachable from wherever the dashboard runs; the key is sent in
# the X-API-Key header. Server-side only — never expose with NEXT_PUBLIC_.
CLUB_AUTOMATION_API_URL=http://127.0.0.1:8000
CLUB_AUTOMATION_API_KEY=your_automation_api_key
# Cloudflare Access service token guarding the API's public hostname. Leave
# unset when calling the API directly on localhost.
CLUB_AUTOMATION_ACCESS_CLIENT_ID=
CLUB_AUTOMATION_ACCESS_CLIENT_SECRET=

# Shared secret for scheduled jobs (vercel.json "crons"). Vercel Cron sends it
# as "Authorization: Bearer <CRON_SECRET>". Used by /api/cron/membership-report,
# which saves the membership summary to the meeting on meeting day.
# Server-side only — any long random string.
CRON_SECRET=

# Access code for the fireworks volunteers' task list (/public/fireworks).
# Checked on the server by /api/public/fireworks; not case-sensitive. Give it
# to volunteers directly. Leave unset to switch the list off.
FIREWORKS_ACCESS_CODE=

# ClubControl Hub login for the dashboard's own account. Used to fetch the
# members export every Monday and on meeting days (and by "Fetch from ClubControl now" on
# /operations/membership) instead of uploading it by hand. Server-side only.
CLUBCONTROL_EMAIL=
CLUBCONTROL_PASSWORD=

# RFU GMS login for the dashboard's own England Rugby account (it needs access
# to the club's Player List). Used to fetch the player list every Monday, on
# meeting days and by "Fetch from GMS now" on /operations/membership.
# Server-side only.
GMS_EMAIL=
GMS_PASSWORD=
# Optional: the club's GMS organisation ids, if they ever change.
# GMS_ORGANISATION_ID=2032
# GMS_LOGIN_ORGANISATION_ID=457475

# Thrive4 (LoveAdmin's new name) login for the dashboard's own account, with
# admin access to the club. Used to fetch the paid LoveAdmin invoices every
# Monday, on meeting days and by "Fetch from Thrive4 now" on
# /operations/membership. Temporary, until everyone has moved to ClubControl
# (LOVEADMIN_MIGRATION.md). Server-side only.
THRIVE4_EMAIL=
THRIVE4_PASSWORD=
# Optional: the club's Thrive4 organisation id, if it ever changes.
# THRIVE4_ORG_GUID=00cf34d8-ba98-4eee-a9b4-e0fa14c2a087

# Website link checker (/operations/link-checker, weekly on Mondays). Optional: the
# site to check, if it isn't the club website.
# LINK_CHECK_SITE_URL=https://www.aldwinians.co.uk/
# When the weekly check finds broken links it emails every admin through
# Resend (RESEND_API_KEY above). Optional sender; falls back to LOTTO_EMAIL_FROM.
# LINK_CHECK_EMAIL_FROM=Aldwinians Dashboard <dashboard@aldwinians.co.uk>
